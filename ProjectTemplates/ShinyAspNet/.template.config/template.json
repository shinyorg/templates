{
    "$schema": "http://json.schemastore.org/template",
    "author": "Shiny .NET",
    "classifications": [ "Shiny" ],
    "name": "Shiny ASP.NET Application",
    "shortName": "shinyaspnet",
    "description": "A project for creating a good starting templates for ASP.NET",
    "identity": "Shiny.Templates.AspNet",
    "sourceName": "ShinyAspNet",
    "preferNameDirectory": true,
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "primaryOutputs": [{
        "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
        "path": "Program.cs"
    }],
    "postActions": [{
        "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
        "description": "Open Program.cs file",
        "manualInstructions": [],
        "actionId": "84C0DA21-51C8-4541-9940-6CA19AF04EE6",
        "args": {
            "files": "0"
        },
        "continueOnError": true
    }],
    "guids": [
        "07CD65EF-6238-4365-AF5D-F6D433967F48",
        "8B51DC95-6D07-4C39-BC6C-3BFE96E8A7EA"
    ],
    "symbols":{
        "Framework": {
            "type": "parameter",
            "description": "The target framework for the project.",
            "dataType": "choice",
            "choices": [{
                "choice": "net10.0",
                "description": "Target .NET 10.0"
            }],
            "replaces": "{DOTNET_TFM}",
            "defaultValue": "net10.0"
        },
        "ef": {
            "type": "parameter",
            "dataType": "choice",
            "defaultValue": "none",
            "description": "Entity Framework Core provider",
            "displayName": "Entity Framework",
            "choices": [
                { "choice": "none",       "description": "None" },
                { "choice": "sqlserver",  "description": "SQL Server" },
                { "choice": "postgresql", "description": "PostgreSQL" }
            ]
        },
        "efspatial": {
            "type": "parameter",
            "dataType": "bool",
            "defaultValue": "false",
            "description": "Adds NetTopologySuite spatial support to the EF Core provider",
            "displayName": "EF Spatial (NetTopologySuite)"
        },
        "documentdb": {
            "type": "parameter",
            "dataType": "choice",
            "defaultValue": "none",
            "description": "Adds Shiny.DocumentDb with the chosen storage provider",
            "displayName": "Shiny.DocumentDb Provider",
            "choices": [
                { "choice": "none",       "description": "No DocumentDb provider" },
                { "choice": "sqlite",     "description": "Shiny.DocumentDb.Sqlite" },
                { "choice": "sqlcipher",  "description": "Shiny.DocumentDb.Sqlite.SqlCipher" },
                { "choice": "sqlserver",  "description": "Shiny.DocumentDb.SqlServer" },
                { "choice": "mysql",      "description": "Shiny.DocumentDb.MySql" },
                { "choice": "postgresql", "description": "Shiny.DocumentDb.PostgreSql" },
                { "choice": "cosmosdb",   "description": "Shiny.DocumentDb.CosmosDb" },
                { "choice": "mongodb",    "description": "Shiny.DocumentDb.MongoDb" },
                { "choice": "litedb",     "description": "Shiny.DocumentDb.LiteDb" },
                { "choice": "duckdb",     "description": "Shiny.DocumentDb.DuckDb" }
            ]
        },
        "aidocumentdb": {
            "type": "parameter",
            "dataType": "bool",
            "defaultValue": "false",
            "description": "Adds Shiny.DocumentDb.Extensions.AI — exposes document store operations as AI tools",
            "displayName": "DocumentDB AI Tools"
        },
        "documentdbdiagnostics": {
            "type": "parameter",
            "dataType": "bool",
            "defaultValue": "false",
            "description": "Emits OpenTelemetry wiring guidance for the document store — metrics and tracing are always-on inside Shiny.DocumentDb",
            "displayName": "DocumentDB Telemetry & Diagnostics"
        },
        "connectionstring": {
            "type": "parameter",
            "dataType": "string",
            "description": "Your Database Connection String",
            "defaultValue": "",
            "replaces":"{CONNECTION_STRING}"
        },
        "signalr": {
            "type": "parameter",
            "dataType": "bool",
            "defaultValue": "false",
            "description": "SignalR — real-time messaging with sample hub",
            "displayName": "SignalR"
        },
        "jwtauth": {
            "type": "parameter",
            "dataType": "bool",
            "defaultValue": "true",
            "description": "JWT bearer authentication with refresh tokens & sample sign-in/out handlers",
            "displayName": "JWT Authentication"
        },
        "google": {
            "type": "parameter",
            "dataType": "bool",
            "defaultValue": "false",
            "description": "Microsoft.AspNetCore.Authentication.Google",
            "displayName": "Google Authentication"
        },
        "facebook": {
            "type": "parameter",
            "dataType": "bool",
            "defaultValue": "false",
            "description": "Microsoft.AspNetCore.Authentication.Facebook",
            "displayName": "Facebook Authentication"
        },
        "apple": {
            "type": "parameter",
            "dataType": "bool",
            "defaultValue": "false",
            "description": "AspNet.Security.OAuth.Apple",
            "displayName": "Apple Authentication"
        },
        "orleans": {
            "type": "parameter",
            "dataType": "bool",
            "defaultValue": "true",
            "description": "Microsoft Orleans distributed actor model framework with sample grain",
            "displayName": "Microsoft Orleans"
        },
        "shinymediator": {
            "type": "parameter",
            "dataType": "bool",
            "defaultValue": "true",
            "description": "Source-generated mediator with endpoints, middleware, and handlers (Shiny.Mediator.AspNet)",
            "displayName": "Shiny Mediator"
        },
        "localization": {
            "type": "parameter",
            "dataType": "bool",
            "defaultValue": "false",
            "description": "Source-generated localization (Shiny.Extensions.Localization.Generator)",
            "displayName": "Localization"
        },
        "reflector": {
            "type": "parameter",
            "dataType": "bool",
            "defaultValue": "false",
            "description": "AOT-compatible source-generated reflection (Shiny.Extensions.Reflector)",
            "displayName": "Reflector"
        },
        "scalar": {
            "type": "parameter",
            "dataType": "bool",
            "defaultValue": "true",
            "description": "Scalar OpenAPI documentation UI",
            "displayName": "Scalar API Docs"
        },
        "deeplinks": {
            "type": "parameter",
            "dataType": "bool",
            "defaultValue": "true",
            "description": "Include sample apple-app-site-association and assetlinks.json under wwwroot/.well-known",
            "displayName": "Mobile Deep Link Files"
        },
        "efmssql":{
            "type": "computed",
            "dataType": "bool",
            "value": "(ef == \"sqlserver\")"
        },
        "efpostgres":{
            "type": "computed",
            "dataType": "bool",
            "value": "(ef == \"postgresql\")"
        },
        "efnone":{
            "type": "computed",
            "dataType": "bool",
            "value": "(ef == \"none\")"
        },
        "docdbnone": {
            "type": "computed",
            "dataType": "bool",
            "value": "(documentdb == \"none\")"
        },
        "usedocumentdb": {
            "type": "computed",
            "dataType": "bool",
            "value": "(documentdb != \"none\")"
        },
        "docdbsqlite": {
            "type": "computed",
            "dataType": "bool",
            "value": "(documentdb == \"sqlite\")"
        },
        "docdbsqlcipher": {
            "type": "computed",
            "dataType": "bool",
            "value": "(documentdb == \"sqlcipher\")"
        },
        "docdbsqlserver": {
            "type": "computed",
            "dataType": "bool",
            "value": "(documentdb == \"sqlserver\")"
        },
        "docdbmysql": {
            "type": "computed",
            "dataType": "bool",
            "value": "(documentdb == \"mysql\")"
        },
        "docdbpostgres": {
            "type": "computed",
            "dataType": "bool",
            "value": "(documentdb == \"postgresql\")"
        },
        "docdbcosmos": {
            "type": "computed",
            "dataType": "bool",
            "value": "(documentdb == \"cosmosdb\")"
        },
        "docdbmongo": {
            "type": "computed",
            "dataType": "bool",
            "value": "(documentdb == \"mongodb\")"
        },
        "docdblitedb": {
            "type": "computed",
            "dataType": "bool",
            "value": "(documentdb == \"litedb\")"
        },
        "docdbduckdb": {
            "type": "computed",
            "dataType": "bool",
            "value": "(documentdb == \"duckdb\")"
        },
        "useanydata": {
            "type": "computed",
            "dataType": "bool",
            "value": "(ef != \"none\" || documentdb != \"none\")"
        },
        "usemediator": {
            "type": "computed",
            "dataType": "bool",
            "value": "(shinymediator || jwtauth)"
        }
    },
    "sources": [{
        "source": "./",
        "target": "./",
        "copyOnly": [
            "**/*.svg",
            "**/*.ttf",
            "**/*.txt"
        ],
        "modifiers": [
        {
            "condition": "(orleans == false)",
            "exclude": "Grains/**"
        },
        {
            "condition": "(jwtauth == false)",
            "exclude": "Handlers/**"
        },
        {
            "condition": "(jwtauth == false)",
            "exclude": "Infrastructure/AuthModule.cs"
        },
        {
            "condition": "(jwtauth == false)",
            "exclude": "Infrastructure/AuthOptions.cs"
        },
        {
            "condition": "(jwtauth == false)",
            "exclude": "Services/JwtService.cs"
        },
        {
            "condition": "(jwtauth == false)",
            "exclude": "Services/IUserService.cs"
        },
        {
            "condition": "(jwtauth == false)",
            "exclude": "Services/Impl/UserService.cs"
        },
        {
            "condition": "(signalr == false)",
            "exclude": "Infrastructure/SignalrModule.cs"
        },
        {
            "condition": "(signalr == false)",
            "exclude": "Hubs/**"
        },
        {
            "condition": "(usemediator == false)",
            "exclude": "Infrastructure/MediatorModule.cs"
        },
        {
            "condition": "(efnone)",
            "exclude": "Data/AppDbContext.cs"
        },
        {
            "condition": "(deeplinks == false)",
            "exclude": "wwwroot/**"
        }]
    }]
}

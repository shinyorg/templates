<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>{DOTNET_TFM}</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OpenApiDocumentsDirectory>.</OpenApiDocumentsDirectory>
        <MicrosoftVersion>10.0.10</MicrosoftVersion>
        <ShinyExtensionsLocalizationVersion>2.0.1</ShinyExtensionsLocalizationVersion>
        <ShinyExtensionsReflectorVersion>5.1.4</ShinyExtensionsReflectorVersion>
        <ShinyExtensionsDIVersion>5.1.4</ShinyExtensionsDIVersion>
        <ShinyExtensionsWebHostingVersion>5.1.4</ShinyExtensionsWebHostingVersion>
        <ShinyDocumentDbVersion>12.2.1</ShinyDocumentDbVersion>
        <MediatorVersion>6.8.0</MediatorVersion>
        <NpgsqlVersion>10.0.3</NpgsqlVersion>
        <ScalarVersion>2.16.16</ScalarVersion>
        <!--#if (orleans)-->
        <OrleansVersion>10.2.2</OrleansVersion>
        <!--#endif-->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="$(MicrosoftVersion)" />
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="$(MicrosoftVersion)"/>
        <PackageReference Include="Shiny.Extensions.DependencyInjection" Version="$(ShinyExtensionsDIVersion)"/>
        <PackageReference Include="Shiny.Extensions.WebHosting" Version="$(ShinyExtensionsWebHostingVersion)" />

        <!--#if (localization)-->
        <PackageReference Include="Shiny.Extensions.Localization.Generator" Version="$(ShinyExtensionsLocalizationVersion)" />
        <!--#endif-->

        <!--#if (reflector)-->
        <PackageReference Include="Shiny.Extensions.Reflector" Version="$(ShinyExtensionsReflectorVersion)" />
        <!--#endif-->

        <!--#if (efmssql)-->
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(MicrosoftVersion)" />
        <!--#if (efspatial)-->
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer.NetTopologySuite" Version="$(MicrosoftVersion)" />
        <!--#endif-->
        <!--#endif-->

        <!--#if (efpostgres)-->
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(NpgsqlVersion)" />
        <!--#if (efspatial)-->
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="$(NpgsqlVersion)" />
        <!--#endif-->
        <!--#endif-->

        <!--#if (docdbsqlite)-->
        <PackageReference Include="Shiny.DocumentDb.Sqlite" Version="$(ShinyDocumentDbVersion)" />
        <!--#endif-->
        <!--#if (docdbsqlcipher)-->
        <PackageReference Include="Shiny.DocumentDb.Sqlite.SqlCipher" Version="$(ShinyDocumentDbVersion)" />
        <!--#endif-->
        <!--#if (docdbsqlserver)-->
        <PackageReference Include="Shiny.DocumentDb.SqlServer" Version="$(ShinyDocumentDbVersion)" />
        <!--#endif-->
        <!--#if (docdbmysql)-->
        <PackageReference Include="Shiny.DocumentDb.MySql" Version="$(ShinyDocumentDbVersion)" />
        <!--#endif-->
        <!--#if (docdbpostgres)-->
        <PackageReference Include="Shiny.DocumentDb.PostgreSql" Version="$(ShinyDocumentDbVersion)" />
        <!--#endif-->
        <!--#if (docdbcosmos)-->
        <PackageReference Include="Shiny.DocumentDb.CosmosDb" Version="$(ShinyDocumentDbVersion)" />
        <!--#endif-->
        <!--#if (docdbmongo)-->
        <PackageReference Include="Shiny.DocumentDb.MongoDb" Version="$(ShinyDocumentDbVersion)" />
        <!--#endif-->
        <!--#if (docdblitedb)-->
        <PackageReference Include="Shiny.DocumentDb.LiteDb" Version="$(ShinyDocumentDbVersion)" />
        <!--#endif-->
        <!--#if (docdbduckdb)-->
        <PackageReference Include="Shiny.DocumentDb.DuckDb" Version="$(ShinyDocumentDbVersion)" />
        <!--#endif-->
        <!--#if (aidocumentdb)-->
        <PackageReference Include="Shiny.DocumentDb.Extensions.AI" Version="$(ShinyDocumentDbVersion)" />
        <!--#endif-->

        <!--#if (orleans)-->
        <PackageReference Include="Microsoft.Orleans.Server" Version="$(OrleansVersion)" />
        <PackageReference Include="Microsoft.Orleans.Sdk" Version="$(OrleansVersion)" />
        <PackageReference Include="Microsoft.Orleans.BroadcastChannel" Version="$(OrleansVersion)" />
        <PackageReference Include="Microsoft.Orleans.Hosting.Kubernetes" Version="$(OrleansVersion)"/>
        <PackageReference Include="Microsoft.Orleans.Clustering.AdoNet" Version="$(OrleansVersion)"/>
        <PackageReference Include="Microsoft.Orleans.Persistence.AdoNet" Version="$(OrleansVersion)"/>
        <PackageReference Include="Microsoft.Orleans.Reminders" Version="$(OrleansVersion)"/>
        <PackageReference Include="Microsoft.Orleans.Reminders.AdoNet" Version="$(OrleansVersion)" />
        <PackageReference Include="Microsoft.Orleans.Streaming" Version="$(OrleansVersion)"/>
        <PackageReference Include="Microsoft.Orleans.Streaming.AdoNet" Version="$(OrleansVersion)-alpha.1" />
        <PackageReference Include="Microsoft.Orleans.Dashboard" Version="$(OrleansVersion)" />
        <!--#endif-->

        <!--#if (jwtauth)-->
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(MicrosoftVersion)" />
        <!--#endif-->
        <!--#if (facebook)-->
        <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="$(MicrosoftVersion)" />
        <!--#endif-->
        <!--#if (google)-->
        <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="$(MicrosoftVersion)" />
        <!--#endif-->
        <!--#if (apple)-->
        <PackageReference Include="AspNet.Security.OAuth.Apple" Version="10.0.0" />
        <!--#endif-->

        <!--#if (usemediator)-->
        <PackageReference Include="Shiny.Mediator.AspNet" Version="$(MediatorVersion)" />
        <!--#endif-->
        <!--#if (scalar)-->
        <PackageReference Include="Scalar.AspNetCore" Version="$(ScalarVersion)"/>
        <!--#endif-->
    </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>{DOTNET_TFM}</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <MicrosoftVersion>10.0.10</MicrosoftVersion>
        <ShinyClientVersion>5.4.0</ShinyClientVersion>
        <ShinyControlsVersion>1.0.1-beta-0175</ShinyControlsVersion>
        <ShinyExtensionsLocalizationVersion>2.0.1</ShinyExtensionsLocalizationVersion>
        <ShinyExtensionsStoresVersion>5.1.5</ShinyExtensionsStoresVersion>
        <ShinyExtensionsReflectorVersion>5.1.5</ShinyExtensionsReflectorVersion>
        <ShinyExtensionsDIVersion>5.1.5</ShinyExtensionsDIVersion>
        <ShinyExtensionsBlazorHostingVersion>5.1.5</ShinyExtensionsBlazorHostingVersion>
        <ShinySpeechVersion>3.0.0-beta-0028</ShinySpeechVersion>
        <ShinyAiConversationVersion>3.0.0-beta-0028</ShinyAiConversationVersion>
        <ShinyDocumentDbVersion>13.1.2</ShinyDocumentDbVersion>
        <MediatorVersion>6.8.0</MediatorVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(MicrosoftVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(MicrosoftVersion)" PrivateAssets="all" />

        <!--#if (localization)-->
        <PackageReference Include="Shiny.Extensions.Localization.Generator" Version="$(ShinyExtensionsLocalizationVersion)" />
        <!--#endif-->

        <!--#if (stores)-->
        <PackageReference Include="Shiny.Extensions.Stores" Version="$(ShinyExtensionsStoresVersion)" />
        <!--#endif-->

        <!--#if (reflector)-->
        <PackageReference Include="Shiny.Extensions.Reflector" Version="$(ShinyExtensionsReflectorVersion)" />
        <!--#endif-->

        <!--#if (di)-->
        <PackageReference Include="Shiny.Extensions.DependencyInjection" Version="$(ShinyExtensionsDIVersion)" />
        <!--#endif-->

        <!--#if (blazorhost)-->
        <PackageReference Include="Shiny.Extensions.BlazorHosting" Version="$(ShinyExtensionsBlazorHostingVersion)" />
        <!--#endif-->

        <!--#if (shinymediator)-->
        <PackageReference Include="Shiny.Mediator.Blazor" Version="$(MediatorVersion)" />
        <!--#endif-->

        <!--#if (shinycontrols)-->
        <PackageReference Include="Shiny.Blazor.Controls" Version="$(ShinyControlsVersion)" />
        <!--#endif-->

        <!--#if (markdown)-->
        <PackageReference Include="Shiny.Blazor.Controls.Markdown" Version="$(ShinyControlsVersion)" />
        <!--#endif-->

        <!--#if (mermaiddiagrams)-->
        <PackageReference Include="Shiny.Blazor.Controls.MermaidDiagrams" Version="$(ShinyControlsVersion)" />
        <!--#endif-->

        <!--#if (shinybarcodes)-->
        <PackageReference Include="Shiny.Blazor.Controls.Barcodes" Version="$(ShinyControlsVersion)" />
        <!--#endif-->

        <!--#if (shinykiosk)-->
        <PackageReference Include="Shiny.Blazor.Controls.Kiosk" Version="$(ShinyControlsVersion)" />
        <!--#endif-->

        <!--#if (bluetoothle)-->
        <PackageReference Include="Shiny.BluetoothLE.Blazor" Version="$(ShinyClientVersion)" />
        <!--#endif-->

        <!--#if (gps)-->
        <PackageReference Include="Shiny.Locations.Blazor" Version="$(ShinyClientVersion)" />
        <!--#endif-->

        <!--#if (push)-->
        <PackageReference Include="Shiny.Push.Blazor" Version="$(ShinyClientVersion)" />
        <!--#endif-->

        <!--#if (useshinyspeech)-->
        <PackageReference Include="Shiny.Speech" Version="$(ShinySpeechVersion)" />
        <!--#endif-->

        <!--#if (aiconversation)-->
        <PackageReference Include="Shiny.AiConversation" Version="$(ShinyAiConversationVersion)" />
        <!--#endif-->

        <!--#if (documentdb)-->
        <PackageReference Include="Shiny.DocumentDb.IndexedDb" Version="$(ShinyDocumentDbVersion)" />
        <!--#endif-->

        <!--#if (mudblazor)-->
        <PackageReference Include="MudBlazor" Version="9.8.0" />
        <!--#endif-->

        <!--#if (radzen)-->
        <PackageReference Include="Radzen.Blazor" Version="11.2.2" />
        <!--#endif-->

        <!--#if (fluentui)-->
        <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.14.4" />
        <!--#endif-->
    </ItemGroup>

</Project>
